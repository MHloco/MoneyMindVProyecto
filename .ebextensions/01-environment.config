option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: none
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: basic
  aws:autoscaling:asg:
    MinSize: '1'
    MaxSize: '1'
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    MatcherHTTPCode: '200'
  aws:elbv2:loadbalancer:
    IdleTimeout: '90'
